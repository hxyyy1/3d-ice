// Reference thermal model: HBM3E 24 GB, 8-high DRAM + one buffer die.
// Public product envelope: 11 x 11 x 0.72 mm.
// This is a transparent literature-derived model, not a vendor process deck.
// Conductivity calibration: ../../thermal_calibration/thermal_conductivity_calibration.tex.

material SILICON :
  thermal conductivity 1.30000e-4 ;
  volumetric heat capacity 1.71000e-12 ;

material TSV_SI_HBM3E_EQ :
  thermal conductivity 1.30847e-4, 1.30847e-4, 1.31688e-4 ;
  volumetric heat capacity 1.72129e-12 ;

material EMC :
  thermal conductivity 8.80000e-7 ;
  volumetric heat capacity 1.52000e-12 ;

// Homogenized 10.5 x 10.5 mm Si core plus 250 um EMC perimeter.
material ACTIVE_LAYER_EQ :
  thermal conductivity 1.65659e-5, 1.65659e-5, 1.18529e-4 ;
  volumetric heat capacity 1.62551e-12 ;

material NCF_BUMP_EQ :
  thermal conductivity 2.99142e-7, 2.99142e-7, 1.22500e-6 ;
  volumetric heat capacity 1.43800e-12 ;

dimensions :
  chip length 11000, width 11000 ;
  cell length 250, width 250 ;
  non-uniform true ;

// The thick top-silicon layer closes the published 720 um cube envelope.
// Its 342 um thickness is derived, not a disclosed Micron/SK hynix dimension.
layer TOP_SILICON_CAP :
  height 342 ;
  material SILICON ;
  layout "top_silicon.layout" ;

layer TSV_SILICON_30 :
  height 30 ;
  material SILICON ;
  layout "tsv_silicon.layout" ;

layer DIE_TO_DIE_BOND :
  height 15 ;
  material NCF_BUMP_EQ ;

die DRAM_ACTIVE :
  source 2 ACTIVE_LAYER_EQ ;

die BUFFER_ACTIVE :
  source 2 ACTIVE_LAYER_EQ ;

stack:
  layer HBM3E_D8_CAP TOP_SILICON_CAP ;
  die   HBM3E_D8 DRAM_ACTIVE floorplan "dram_core.flp" ;
  layer HBM3E_BOND_D8_D7 DIE_TO_DIE_BOND ;

  layer HBM3E_D7_SUBSTRATE TSV_SILICON_30 ;
  die   HBM3E_D7 DRAM_ACTIVE floorplan "dram_core.flp" ;
  layer HBM3E_BOND_D7_D6 DIE_TO_DIE_BOND ;

  layer HBM3E_D6_SUBSTRATE TSV_SILICON_30 ;
  die   HBM3E_D6 DRAM_ACTIVE floorplan "dram_core.flp" ;
  layer HBM3E_BOND_D6_D5 DIE_TO_DIE_BOND ;

  layer HBM3E_D5_SUBSTRATE TSV_SILICON_30 ;
  die   HBM3E_D5 DRAM_ACTIVE floorplan "dram_core.flp" ;
  layer HBM3E_BOND_D5_D4 DIE_TO_DIE_BOND ;

  layer HBM3E_D4_SUBSTRATE TSV_SILICON_30 ;
  die   HBM3E_D4 DRAM_ACTIVE floorplan "dram_core.flp" ;
  layer HBM3E_BOND_D4_D3 DIE_TO_DIE_BOND ;

  layer HBM3E_D3_SUBSTRATE TSV_SILICON_30 ;
  die   HBM3E_D3 DRAM_ACTIVE floorplan "dram_core.flp" ;
  layer HBM3E_BOND_D3_D2 DIE_TO_DIE_BOND ;

  layer HBM3E_D2_SUBSTRATE TSV_SILICON_30 ;
  die   HBM3E_D2 DRAM_ACTIVE floorplan "dram_core.flp" ;
  layer HBM3E_BOND_D2_D1 DIE_TO_DIE_BOND ;

  layer HBM3E_D1_SUBSTRATE TSV_SILICON_30 ;
  die   HBM3E_D1 DRAM_ACTIVE floorplan "dram_core.flp" ;
  layer HBM3E_BOND_D1_BASE DIE_TO_DIE_BOND ;

  layer HBM3E_BASE_SUBSTRATE TSV_SILICON_30 ;
  die   HBM3E_BASE BUFFER_ACTIVE floorplan "base_die.flp" ;

solver:
  transient step 0.01, slot 0.01 ;
  initial temperature 318.15 ;
  numofcores 1 ;

output:
  Tflp(HBM3E_D8,   "hbm3e_d8_avg.txt",   average, final) ;
  Tflp(HBM3E_D7,   "hbm3e_d7_avg.txt",   average, final) ;
  Tflp(HBM3E_D6,   "hbm3e_d6_avg.txt",   average, final) ;
  Tflp(HBM3E_D5,   "hbm3e_d5_avg.txt",   average, final) ;
  Tflp(HBM3E_D4,   "hbm3e_d4_avg.txt",   average, final) ;
  Tflp(HBM3E_D3,   "hbm3e_d3_avg.txt",   average, final) ;
  Tflp(HBM3E_D2,   "hbm3e_d2_avg.txt",   average, final) ;
  Tflp(HBM3E_D1,   "hbm3e_d1_avg.txt",   average, final) ;
  Tflp(HBM3E_BASE, "hbm3e_base_avg.txt", average, final) ;
  Tflpel(HBM3E_BASE.BASE_ACTIVE_EQ, "hbm3e_base_max.txt", maximum, final) ;
  Tmap(HBM3E_D8,   "hbm3e_top_map.txt", final) ;
  Tmap(HBM3E_BASE, "hbm3e_base_map.txt", final) ;
  T3d("hbm3e_cube.vtk", final) ;
